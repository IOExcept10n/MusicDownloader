<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SUSUProgramming.MusicDownloader.ViewModels"
        xmlns:lang="clr-namespace:SUSUProgramming.MusicDownloader.Localization"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="vm:AutoTaggingViewModel"
        x:Class="SUSUProgramming.MusicDownloader.Views.TaggingResultsWindow"
        Width="800" Height="500"
        Title="{x:Static lang:Resources.TaggingResultsTitle}">
	<Grid RowDefinitions="Auto,*,Auto">
		<TextBlock Margin="8"
				   FontSize="20"
				   Text="{Binding Summary}"/>
		<ScrollViewer Grid.Row="1">
			<ItemsControl ItemsSource="{Binding Items}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:TaggingResultItemViewModel">
						<Grid ColumnDefinitions="40,*,2*,Auto,Auto" Margin="4">
							<TextBlock Grid.Column="0"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Center"
									   FontSize="18"
									   IsVisible="{Binding IsReady}"
									   Text="✅"/>
							<TextBlock Grid.Column="0"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Center"
									   FontSize="18"
									   IsVisible="{Binding NeedsReview}"
									   Text="⚠️"/>
							<TextBlock Grid.Column="1"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"
									   Text="{Binding TrackName}"/>
							<TextBlock Grid.Column="2"
									   VerticalAlignment="Center"
									   Margin="8,0"
									   TextTrimming="CharacterEllipsis"
									   Text="{Binding Reason}"/>
							<Button Grid.Column="3"
									Margin="2"
									IsVisible="{Binding HasUnresolvedConflicts}"
									Content="{x:Static lang:Resources.ReviewTrack}"
									Click="OnReviewClicked"/>
							<TextBlock Grid.Column="4"
									   VerticalAlignment="Center"
									   Margin="4,0"
									   IsVisible="{Binding IsApplied}"
									   Text="💾"/>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
		<Button Grid.Row="2"
				Margin="4"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Center"
				IsEnabled="{Binding HasReady}"
				Content="{Binding ApplyReadyText}"
				Click="OnApplyReadyClicked"/>
	</Grid>
</Window>
